Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(config\.php|.*\.md)$">
    Require all denied
</FilesMatch>

# src/, lang/, partials/, tests/ hold no public files
RedirectMatch 404 ^/exposift/(src|lang|partials|tests)/

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    # Documents are processed in the browser; the page may not talk to other origins.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' blob: data:; object-src 'none'; base-uri 'none'; form-action 'self'"
</IfModule>
